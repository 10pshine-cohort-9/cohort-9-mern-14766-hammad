# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/cohort9_auth

# JWT — replace with a long random string, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Security
BCRYPT_SALT_ROUNDS=10

# CORS
CORS_ORIGIN=*

# Logging — fatal | error | warn | info | debug | trace | silent
# Defaults to debug in development and info in production.
LOG_LEVEL=debug
